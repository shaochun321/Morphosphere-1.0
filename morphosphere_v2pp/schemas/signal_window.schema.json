{
  "$id": "https://morphosphere.local/schemas/signal_window.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalWindow",
  "type": "object",
  "required": ["window_id", "node_id"],
  "additionalProperties": false,
  "schema_version": "1.0",
  "properties": {
    "window_id": { "type": "string" },
    "node_id": { "type": "integer" },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "energy_level": { "type": "number", "default": 0.0 }
  }
}
