  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundaryElasticityRecord",
  "type": "object",
  "required": ["boundary_id", "o_surface_id", "elasticity_score"],
  "additionalProperties": false,
  "schema_version": "1.0",
